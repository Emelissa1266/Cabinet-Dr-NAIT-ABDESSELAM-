# Copy to server/.env.production and generate every value marked GENERATE.
# Never commit the production file or reuse development credentials.
DJANGO_SECRET_KEY=GENERATE_A_RANDOM_VALUE_OF_AT_LEAST_50_CHARACTERS
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=cabinet.local
DJANGO_TIME_ZONE=Africa/Algiers
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_PROXY_SSL_HEADER=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

DB_CONN_MAX_AGE=600
DB_SSL_REQUIRE=False
POSTGRES_DB=clinic_db
POSTGRES_USER=clinic_backup_admin
POSTGRES_PASSWORD=GENERATE_A_RANDOM_DATABASE_ADMIN_PASSWORD
APP_DB_USER=clinic_app
APP_DB_PASSWORD=GENERATE_A_DIFFERENT_RANDOM_APPLICATION_PASSWORD

CORS_ALLOWED_ORIGINS=https://cabinet.local
CSRF_TRUSTED_ORIGINS=https://cabinet.local
CSRF_COOKIE_NAME=clinic_csrftoken
CSRF_COOKIE_SAMESITE=Lax
AUTH_ACCESS_COOKIE_NAME=clinic_access
AUTH_REFRESH_COOKIE_NAME=clinic_refresh
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=True

PRIVATE_MEDIA_ROOT=/app/private_media
DOCUMENT_MAX_UPLOAD_SIZE=10485760
CLINICAL_PHOTO_MAX_UPLOAD_SIZE=15728640
DEFAULT_CURRENCY=DZD

LAN_HOSTNAME=cabinet.local
LAN_BIND_IP=0.0.0.0
LAN_CIDR=192.168.1.0/24
TZ=Africa/Algiers

# Must be a physically separate encrypted drive or protected network share.
BACKUP_DESTINATION=E:/ClinicBackups
RESTIC_PASSWORD=GENERATE_A_RANDOM_BACKUP_ENCRYPTION_PASSWORD
BACKUP_DATABASE_INTERVAL_HOURS=6
BACKUP_DAILY_HOUR=2
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_MONTHS=12

GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
REMINDER_INTERVAL_SECONDS=300
