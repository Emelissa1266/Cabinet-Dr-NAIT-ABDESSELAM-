DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-production-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=replace-with-production-host.example
DJANGO_TIME_ZONE=Africa/Algiers

DATABASE_URL=postgresql://replace-user:replace-password@replace-host:5432/replace-db
DB_CONN_MAX_AGE=600
DB_SSL_REQUIRE=True

CORS_ALLOWED_ORIGINS=https://replace-with-frontend-origin.example
CSRF_TRUSTED_ORIGINS=https://replace-with-frontend-origin.example
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=True

PRIVATE_MEDIA_ROOT=/srv/clinic/private_media
DOCUMENT_MAX_UPLOAD_SIZE=10485760
CLINICAL_PHOTO_MAX_UPLOAD_SIZE=15728640
DEFAULT_CURRENCY=DZD

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_PROXY_SSL_HEADER=False
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
SECURITY_CSP_REPORT_ONLY=True

RATE_LIMIT_REDIS_URL=redis://replace-redis-host:6379/0
RATE_LIMIT_CACHE_ALIAS=rate_limit
RATE_LIMIT_REQUIRE_SHARED_CACHE=True
TRUSTED_PROXY_IPS=
