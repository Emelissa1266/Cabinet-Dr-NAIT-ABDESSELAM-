DJANGO_SECRET_KEY=replace-with-a-local-development-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Algiers

DATABASE_URL=postgresql://clinic_user:clinic_dev_password@127.0.0.1:5432/clinic_db
DB_CONN_MAX_AGE=600
DB_SSL_REQUIRE=False

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

PRIVATE_MEDIA_ROOT=private_media
DOCUMENT_MAX_UPLOAD_SIZE=10485760
CLINICAL_PHOTO_MAX_UPLOAD_SIZE=15728640
DEFAULT_CURRENCY=DZD

# Required only when creating new seed_demo accounts; never commit a real value.
CLINIC_DEMO_PASSWORD=

# Optional employer-facing certificate wording, validated by the physician before production.
# Allowed placeholders: {doctor}, {patient}, {duration}, {start}, {end}.
# WORK_LEAVE_CERTIFICATE_TEXT="Je soussigné, {doctor}, prescris un arrêt de travail pour {patient}, d'une durée de {duration} jours calendaires, du {start} au {end} inclus."
