DJANGO_SECRET_KEY=replace-with-a-local-development-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Algiers

DATABASE_URL=postgresql://clinic_user:clinic_dev_password@127.0.0.1:5432/clinic_db
DB_CONN_MAX_AGE=600
DB_SSL_REQUIRE=False

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

PRIVATE_MEDIA_ROOT=private_media
DOCUMENT_MAX_UPLOAD_SIZE=10485760
CLINICAL_PHOTO_MAX_UPLOAD_SIZE=15728640
DEFAULT_CURRENCY=DZD

# Rate limiting
# Local development uses Django's local-memory cache. Production should configure
# a shared cache alias (for example Redis with django-redis installed) for
# multi-worker abuse protection.
RATE_LIMIT_CACHE_ALIAS=default
RATE_LIMIT_REQUIRE_SHARED_CACHE=False
RATE_LIMIT_REDIS_URL=
TRUSTED_PROXY_IPS=
RATE_LIMIT_AUTH_LOGIN_IP=10/min
RATE_LIMIT_AUTH_LOGIN_ACCOUNT=5/5min
RATE_LIMIT_AUTH_LOGIN_GLOBAL=120/min
RATE_LIMIT_AUTH_REFRESH=30/min
RATE_LIMIT_AUTH_CSRF=60/min
RATE_LIMIT_AUTH_SESSION=120/min
RATE_LIMIT_API_GENERAL=1000/min
RATE_LIMIT_SENSITIVE_WRITE=120/min
RATE_LIMIT_EXPENSIVE_SEARCH=120/min
RATE_LIMIT_FILE_UPLOAD=30/min
RATE_LIMIT_PRIVATE_DOWNLOAD=120/min
RATE_LIMIT_PDF_GENERATION=30/min
